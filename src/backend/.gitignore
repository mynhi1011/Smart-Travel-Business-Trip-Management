# ── Environment & Secrets ────────────────────────────────────
.env
.env.local
.env.*.local
.env.test

# ── Database (SQLite dev files) ───────────────────────────────
*.db
*.db-journal
*.db-shm
*.db-wal
src/prisma/*.db

# ── Build Output ─────────────────────────────────────────────
dist/
build/
coverage/

# ── Node Modules ─────────────────────────────────────────────
node_modules/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

