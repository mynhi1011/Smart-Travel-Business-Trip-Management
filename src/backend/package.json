{
  "name": "smart-travel-backend",
  "version": "1.0.0",
  "description": "Smart Travel & Business Trip Management — Backend API (Node.js + Express + TypeScript)",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "scripts": {
    "dev":              "tsx watch src/server.ts",
    "build":            "npm run build:frontend && tsc",
    "build:frontend":   "npm --prefix ../frontend run build",
    "start":            "node dist/server.js",
    "type-check":       "tsc --noEmit",

    "db:generate":      "prisma generate",
    "db:migrate":       "prisma migrate dev",
    "db:migrate:prod":  "prisma migrate deploy",
    "db:seed":          "tsx src/prisma/seed.ts",
    "db:setup":         "prisma migrate dev --skip-seed; tsx src/prisma/seed.ts",
    "db:reset":         "prisma migrate reset --force; tsx src/prisma/seed.ts",
    "db:validate":      "prisma validate",
    "db:studio":        "prisma studio"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
