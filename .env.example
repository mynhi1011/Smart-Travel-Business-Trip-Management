# ============================================================
# .env.example — Smart Travel & Business Trip Management
# Project Root
#
# Dự án có 2 sub-projects, mỗi project có .env riêng:
#   src/backend/.env   — Backend API (Node.js + Express)
#   src/frontend/.env  — Frontend SPA (React + Vite) [nếu cần]
#
# Xem file .env.example trong từng thư mục để biết chi tiết.
# ============================================================

# ── Backend (src/backend/.env) ────────────────────────────────
# DATABASE_URL="file:./dev.db"
# PORT=5000
# NODE_ENV=development
# JWT_ACCESS_SECRET=...
# JWT_REFRESH_SECRET=...
# GEMINI_API_KEY=...
# CORS_ORIGIN=http://localhost:5173

# ── Frontend (src/frontend/.env) ──────────────────────────────
# VITE_API_BASE_URL=/api/v1
